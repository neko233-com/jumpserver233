// Native single-node deployment on BuildWorld's builtin macOS executor.
pipeline {
    agent any
    options {
        disableConcurrentBuilds()
        timeout(time: 30, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10', artifactNumToKeepStr: '3'))
    }
    parameters {
        booleanParam(name: 'DEPLOY', defaultValue: true, description: 'Deploy this project on the current macOS node, retaining data and keys')
        booleanParam(name: 'RUN_TESTS', defaultValue: true, description: 'Run Go, helper, static and content checks before packaging')
        string(name: 'JMS_PORT', defaultValue: '8180', description: 'Dedicated intranet HTTP port; refuse a foreign listener')
    }
    stages {
        stage('Preflight') {
            steps { sh 'sh scripts/run-macos-single.sh preflight' }
        }
        stage('Verify') {
            steps { sh 'sh scripts/run-macos-single.sh verify' }
        }
        stage('Build and package') {
            steps {
                sh 'sh scripts/run-macos-single.sh package'
                archiveArtifacts artifacts: 'dist/*.tar.gz,dist/*.sha256,dist/release/manifest.json', fingerprint: true
            }
        }
        stage('Deploy and health check') {
            steps { sh 'sh scripts/run-macos-single.sh deploy' }
        }
    }
}
